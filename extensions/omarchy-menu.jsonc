  "trigger.hardware.hybrid-gpu": {"icon": "","label": "GPU híbrida","action": "omarchy-launch-floating-terminal-with-presentation omarchy-toggle-hybrid-gpu","when": "omarchy-hw-hybrid-gpu"},
