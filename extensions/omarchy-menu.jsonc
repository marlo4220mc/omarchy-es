  "trigger.capture": {"icon": "","label": "Captura","aliases": ["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon": "","label": "Captura de pantalla","action": "omarchy-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon": "","label": "Detener la grabación","action": "omarchy-capture-screenrecording --stop-recording","when": "pgrep -f '^gpu-screen-recorder'"},
  "trigger.capture.screenrecord": {"icon": "","label": "Grabar pantalla"},
  "trigger.capture.text": {"icon": "󰴑","label": "Texto","action": "omarchy-capture-text"},
  "trigger.capture.qr": {"icon": "󰐲","label": "Código QR","action": "omarchy-capture-qr"},
  "trigger.capture.color": {"icon": "󰃉","label": "Color","action": "pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon": "","label": "Sin audio","action": "omarchy-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon": "","label": "Con audio del sistema","action": "omarchy-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon": "","label": "Con audio del sistema y del micrófono","action": "omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon": "","label": "Con sistema + micrófono + webcam","action": "omarchy-capture-screenrecording-with-webcam","when": "omarchy-hw-webcam"},
  "trigger.transcode": {"icon": "󰧸","label": "Transcodificar","action": "omarchy-transcode"},
