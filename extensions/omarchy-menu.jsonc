  "trigger.hardware.touchpad-haptics.mid": {"icon": "󰌌","label": "Media","action": "dell-xps-touchpad-haptics set mid","when": "omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics","checked": "[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]"},
  "trigger.hardware.touchpad-haptics.high": {"icon": "󰌌","label": "Alta","action": "dell-xps-touchpad-haptics set high","when": "omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics","checked": "[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]"},
